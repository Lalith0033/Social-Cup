{
  "name": "@social-cup/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 4000 --host localhost",
    "android": "expo start --android --port 4000 --host localhost",
    "ios": "expo start --ios --port 4000 --host localhost",
